# Copy to .env for local dev (never commit .env)
PORT=3000

# Shared party access code — anyone with this code (via ?party=CODE link) can open the terminal
PARTY_CODE=mecha-mercs

# DM password — unlocks edit-everything + house rules
DM_PASSWORD=changeme

# Random secret used to sign the DM session token
SESSION_SECRET=please-change-to-a-long-random-string

# Postgres connection string. Leave UNSET for local file storage (data.json).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# PGSSL=disable   # uncomment for a local Postgres without SSL
